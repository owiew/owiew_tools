---
/**
 * Layout base: <head> completo (título, descrição, canonical, hreflang,
 * Open Graph, Twitter, CSP, JSON-LD), cabeçalho, conteúdo e rodapé.
 * Onde: todas as páginas localizadas. Entradas: idioma, título, descrição,
 * caminho da página, alternates por idioma, imagem OG, JSON-LD e noindex.
 */
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { HTML_LANG, LANGS, OG_LOCALE, type Lang } from "../i18n/locales";
import { ui } from "../i18n/ui";
import { type JsonLd, serializeJsonLd } from "../lib/jsonld";
import { absolute } from "../lib/urls";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates: Record<Lang, string>;
  ogImage: string;
  jsonLd?: JsonLd[];
  noindex?: boolean;
  activeCategory?: string | undefined;
}
const { lang, title, description, path, alternates, ogImage, jsonLd = [], noindex = false, activeCategory } = Astro.props;
const t = ui(lang);
const fullTitle = title.includes("owiew tools") ? title : `${title} | owiew tools`;
// CSP por meta: connect-src 'self' garante no navegador que nenhum dado vai para terceiros.
const csp = "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'";
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute(path)} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={absolute(alternates[l])} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(alternates["pt-br"])} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="owiew tools" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(path)} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={absolute(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(ogImage)} />
    <meta name="theme-color" content="#f8f9fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0e1c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Resolve o tema antes da pintura (evita piscar). Storage pode falhar: cai no sistema.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("owiew-tools-theme");
        } catch {
          theme = null;
        }
        const resolved = theme === "light" || theme === "dark" ? theme : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", resolved);
      })();
    </script>
    {jsonLd.map((block) => <script type="application/ld+json" set:html={serializeJsonLd(block)} />)}
  </head>
  <body>
    <a class="skip" href="#conteudo">{t.skip}</a>
    <Header lang={lang} alternates={alternates} activeCategory={activeCategory} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
