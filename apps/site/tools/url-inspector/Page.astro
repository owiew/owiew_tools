---
/**
 * Monta a ilha do Inspetor de URL. Onde: rota de ferramenta (registry via
 * import.meta.glob). Entrada: idioma da página.
 */
import { type Lang } from "../../src/i18n/locales";
import UrlInspector from "./Ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<UrlInspector client:load lang={lang} />
