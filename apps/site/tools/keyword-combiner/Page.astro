---
/**
 * Monta a ilha da ferramenta Combinador de palavras-chave. Onde: rota de ferramenta (registry via
 * import.meta.glob). Entrada: idioma da página.
 */
import { type Lang } from "../../src/i18n/locales";
import KeywordCombiner from "./Ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<KeywordCombiner client:load lang={lang} />
