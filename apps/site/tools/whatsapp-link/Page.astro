---
/**
 * Monta a ilha do Gerador de link de WhatsApp. Onde: rota de ferramenta
 * (registry via import.meta.glob). Entrada: idioma da página.
 */
import { type Lang } from "../../src/i18n/locales";
import WhatsappLink from "./Ui";

