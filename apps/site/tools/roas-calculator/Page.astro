---
/**
 * Monta a ilha da Calculadora de ROAS. Onde: rota de ferramenta (registry via
 * import.meta.glob). Entrada: idioma da página.
 */
import { type Lang } from "../../src/i18n/locales";
import RoasCalculator from "./Ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<RoasCalculator client:load lang={lang} />
