---
/**
 * Monta a ilha do Gerador de nomenclatura de campanhas. Onde: usada pela rota
 * de ferramenta (registry via import.meta.glob). Entrada: idioma da página.
 */
import { type Lang } from "../../src/i18n/locales";
import CampaignNaming from "./Ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<CampaignNaming client:load lang={lang} />
