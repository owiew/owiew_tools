---
/**
 * Monta a ilha do Gerador de UTM. Onde: usada pela rota de ferramenta
 * (registry via import.meta.glob). Entrada: idioma da página.
 */
import { type Lang } from "../../src/i18n/locales";
import UtmBuilder from "./Ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<UtmBuilder client:load lang={lang} />
