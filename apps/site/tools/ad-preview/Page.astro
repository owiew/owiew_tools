---
/**
 * Monta a ilha da ferramenta Prévia e contador de anúncio. Onde: rota de ferramenta (registry via
 * import.meta.glob). Entrada: idioma da página.
 */
import { type Lang } from "../../src/i18n/locales";
import AdPreview from "./Ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<AdPreview client:load lang={lang} />
